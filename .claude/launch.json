{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portal-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3100", "--directory", "out"],
      "port": 3100
    },
    {
      "name": "portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "portal-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    }
  ]
}